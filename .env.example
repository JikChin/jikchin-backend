# Copy this file to .env, then replace all example passwords and JWT_SECRET.
MYSQL_DATABASE=jikchin_benchmark
MYSQL_USER=jikchin_local
MYSQL_PASSWORD=replace_with_local_password
MYSQL_ROOT_PASSWORD=replace_with_local_root_password
MYSQL_PORT=3306
# Use linux/arm64 on Apple Silicon unless an image-specific compatibility issue requires linux/amd64.
MYSQL_PLATFORM=linux/arm64

# Generate with: openssl rand -base64 48
JWT_SECRET=replace_with_base64_secret
JWT_ISSUER=jikchin-backend
JWT_ACCESS_TOKEN_EXPIRATION=15m
JWT_REFRESH_TOKEN_EXPIRATION=14d

JPA_DDL_AUTO=update
