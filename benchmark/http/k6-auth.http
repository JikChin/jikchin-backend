@baseUrl = http://localhost:8080
@adminEmail = admin@jikchin.com
@adminPassword = password1234

###
# Run once only when the benchmark account does not exist yet.
POST {{baseUrl}}/api/auth/signup
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}",
  "nickname": "k6-admin",
  "gender": "MALE",
  "birthDate": "1995-01-01",
  "region": "서울"
}

###
# Run after the account has ROLE_ADMIN to call /api/admin/events.
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

> {%
  const accessToken = response.body.data.accessToken;
  client.global.set("k6_admin_access_token", accessToken);
  client.log("k6 ADMIN_ACCESS_TOKEN: " + accessToken);
%}
