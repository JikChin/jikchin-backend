        <mxCell id="21" value="신고에는 경기 활동 로그를 기록하지 않습니다. 후기와 달리 같은 상대라도 사유가 다르면 별도 신고가 가능합니다." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontColor=#cbd5e1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
