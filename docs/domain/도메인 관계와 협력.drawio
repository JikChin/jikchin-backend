        <mxCell id="2" value="05  후기와 신고 처리의 협력" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=28;fontColor=#f3f4f6;strokeColor=none;fillColor=none;" parent="1" vertex="1">
