        <mxCell id="2" value="04  모집에서 참여까지의 협력" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=28;fontColor=#f3f4f6;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="50" y="28" width="1500" height="46" as="geometry" />
