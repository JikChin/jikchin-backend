        <mxCell id="16" value="0..1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#f3f4f6;strokeColor=none;fillColor=none;align=center;" parent="15" vertex="1" connectable="0">
          <mxGeometry x="-1" width="48" height="24" relative="1" as="geometry">
            <mxPoint x="34" y="-16" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="17" value="0..*" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#f3f4f6;strokeColor=none;fillColor=none;align=center;" parent="15" vertex="1" connectable="0">
          <mxGeometry x="1" width="48" height="24" relative="1" as="geometry">
            <mxPoint x="-32" y="-16" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="18" value="subject_id · 선택" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=none;startArrow=none;strokeColor=#94a3b8;strokeWidth=2;dashed=0;fontColor=#f3f4f6;fontSize=15;fontFamily=Helvetica;labelBackgroundColor=#111827;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="8" target="6" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="19" value="0..1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#f3f4f6;strokeColor=none;fillColor=none;align=center;" parent="18" vertex="1" connectable="0">
          <mxGeometry x="-1" width="48" height="24" relative="1" as="geometry">
            <mxPoint x="-32" y="-16" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="20" value="0..*" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#f3f4f6;strokeColor=none;fillColor=none;align=center;" parent="18" vertex="1" connectable="0">
          <mxGeometry x="1" width="48" height="24" relative="1" as="geometry">
            <mxPoint x="34" y="-16" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="21" value="실선은 번호를 통한 개념적 관계입니다.&#xa;로그에는 외래 키가 없으므로 원본이 사라져도&#xa;기록의 번호는 남습니다." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontColor=#cbd5e1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="1130" y="185" width="400" height="110" as="geometry" />
        </mxCell>
        <mxCell id="22" value="기록을 만드는 활동" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=24;fontColor=#f3f4f6;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="70" y="755" width="1450" height="40" as="geometry" />
        </mxCell>
        <mxCell id="23" value="모집글 생성&#xa;+5 · 원본: 모집글" style="rounded=0;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=19;fontColor=#f3f4f6;fillColor=#111827;strokeColor=#e5e7eb;strokeWidth=2;spacing=12;" parent="1" vertex="1">
          <mxGeometry x="70" y="825" width="330" height="100" as="geometry" />
        </mxCell>
        <mxCell id="24" value="신청 수락&#xa;+2 · 원본: 신청" style="rounded=0;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=19;fontColor=#f3f4f6;fillColor=#111827;strokeColor=#e5e7eb;strokeWidth=2;spacing=12;" parent="1" vertex="1">
          <mxGeometry x="440" y="825" width="330" height="100" as="geometry" />
        </mxCell>
        <mxCell id="25" value="내부 직접 참여 추가&#xa;+2 · 원본: 참여 기록" style="rounded=0;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=19;fontColor=#f3f4f6;fillColor=#111827;strokeColor=#e5e7eb;strokeWidth=2;spacing=12;" parent="1" vertex="1">
          <mxGeometry x="810" y="825" width="330" height="100" as="geometry" />
        </mxCell>
        <mxCell id="26" value="후기 작성&#xa;+3 · 원본: 후기" style="rounded=0;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=19;fontColor=#f3f4f6;fillColor=#111827;strokeColor=#e5e7eb;strokeWidth=2;spacing=12;" parent="1" vertex="1">
          <mxGeometry x="1180" y="825" width="330" height="100" as="geometry" />
        </mxCell>
        <mxCell id="27" value="로그의 source_type / source_id는 위 활동의 원본 종류와 번호를 기록합니다. 직접 참여 추가는 행동한 회원이 비어 있습니다.&#xa;업무 저장과 로그 저장은 함께 성공하거나 취소됩니다. 점수는 활동 이력의 합계이며 회원 매너 점수와 다릅니다." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontColor=#cbd5e1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="60" y="970" width="1480" height="70" as="geometry" />
        </mxCell>
        <mxCell id="28" value="시각은 UTC 기준 · 지난 12개월 전체와 이번 달을 보관하는 정책 · 실제 정리는 관리/삭제 설정에 따라 실행&#xa;로그는 JPA 엔티티가 아닌 직접 SQL 기록입니다. 상세 설정은 docs/event-activity-logs.md를 참고하세요." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontColor=#cbd5e1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="60" y="1070" width="1480" height="70" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page4" name="04  모집에서 참여까지의 협력">
    <mxGraphModel dx="10090" dy="6150" grid="1" gridSize="20" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1310" background="#111827" math="0" shadow="0">
      <root>
