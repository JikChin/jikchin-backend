        <mxCell id="3" value="점선 화살표는 업무 처리 순서입니다. 파란 상자는 해당 흐름의 중심 모델 또는 중심 단계입니다." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontColor=#cbd5e1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
