        <mxCell id="3" value="점선 화살표와 번호는 처리 순서입니다. 서비스가 각 모델의 협력을 조정하며, 모델이 서로 직접 호출한다는 뜻은 아닙니다." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontColor=#cbd5e1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="50" y="86" width="1500" height="48" as="geometry" />
        </mxCell>
        <mxCell id="4" value="A. 모집글 생성 · MatePostService" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=24;fontColor=#f3f4f6;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="60" y="155" width="1480" height="40" as="geometry" />
        </mxCell>
        <mxCell id="5" value="1. 회원 확인&#xa;Member" style="rounded=0;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=19;fontColor=#f3f4f6;fillColor=#111827;strokeColor=#e5e7eb;strokeWidth=2;spacing=12;" parent="1" vertex="1">
          <mxGeometry x="60" y="230" width="310" height="135" as="geometry" />
        </mxCell>
        <mxCell id="6" value="2. 모집글 생성&#xa;MatePost&#xa;OPEN · 현재 인원 1" style="rounded=0;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=19;fontColor=#f3f4f6;fillColor=#153044;strokeColor=#67e8f9;strokeWidth=2;spacing=12;" parent="1" vertex="1">
          <mxGeometry x="450" y="230" width="310" height="135" as="geometry" />
        </mxCell>
        <mxCell id="7" value="3. 모집자 자동 참여&#xa;MateMember&#xa;ACTIVE" style="rounded=0;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=19;fontColor=#f3f4f6;fillColor=#111827;strokeColor=#e5e7eb;strokeWidth=2;spacing=12;" parent="1" vertex="1">
          <mxGeometry x="840" y="230" width="310" height="135" as="geometry" />
        </mxCell>
        <mxCell id="8" value="4. 활동 기록&#xa;event_activity_logs&#xa;+5 · 활성화 시" style="rounded=0;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=19;fontColor=#f3f4f6;fillColor=#111827;strokeColor=#e5e7eb;strokeWidth=2;spacing=12;" parent="1" vertex="1">
          <mxGeometry x="1230" y="230" width="310" height="135" as="geometry" />
        </mxCell>
        <mxCell id="9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=open;startArrow=none;strokeColor=#67e8f9;strokeWidth=2;dashed=1;fontColor=#f3f4f6;fontSize=15;fontFamily=Helvetica;labelBackgroundColor=#111827;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="5" target="6" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=open;startArrow=none;strokeColor=#67e8f9;strokeWidth=2;dashed=1;fontColor=#f3f4f6;fontSize=15;fontFamily=Helvetica;labelBackgroundColor=#111827;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="6" target="7" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=open;startArrow=none;strokeColor=#67e8f9;strokeWidth=2;dashed=1;fontColor=#f3f4f6;fontSize=15;fontFamily=Helvetica;labelBackgroundColor=#111827;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="7" target="8" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="12" value="2~4는 같은 저장 작업: 모집글과 모집자의 참여 기록이 함께 만들어집니다. 생성 요청의 정원은 최소 2명입니다." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontColor=#cbd5e1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="60" y="390" width="1480" height="60" as="geometry" />
        </mxCell>
        <mxCell id="13" value="B. 참여 신청 · MateApplicationService" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=24;fontColor=#f3f4f6;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="60" y="510" width="1480" height="40" as="geometry" />
        </mxCell>
        <mxCell id="14" value="1. 신청자 확인&#xa;Member" style="rounded=0;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=19;fontColor=#f3f4f6;fillColor=#111827;strokeColor=#e5e7eb;strokeWidth=2;spacing=12;" parent="1" vertex="1">
          <mxGeometry x="60" y="585" width="310" height="135" as="geometry" />
        </mxCell>
        <mxCell id="15" value="2. 모집글 확인&#xa;MatePost&#xa;OPEN · 본인 글 제외" style="rounded=0;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=19;fontColor=#f3f4f6;fillColor=#153044;strokeColor=#67e8f9;strokeWidth=2;spacing=12;" parent="1" vertex="1">
          <mxGeometry x="450" y="585" width="310" height="135" as="geometry" />
        </mxCell>
        <mxCell id="16" value="3. 중복 이력 확인&#xa;MateApplication&#xa;MateMember" style="rounded=0;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=19;fontColor=#f3f4f6;fillColor=#111827;strokeColor=#e5e7eb;strokeWidth=2;spacing=12;" parent="1" vertex="1">
          <mxGeometry x="840" y="585" width="310" height="135" as="geometry" />
        </mxCell>
        <mxCell id="17" value="4. 신청 생성&#xa;MateApplication&#xa;PENDING" style="rounded=0;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=19;fontColor=#f3f4f6;fillColor=#111827;strokeColor=#e5e7eb;strokeWidth=2;spacing=12;" parent="1" vertex="1">
          <mxGeometry x="1230" y="585" width="310" height="135" as="geometry" />
        </mxCell>
        <mxCell id="18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=open;startArrow=none;strokeColor=#67e8f9;strokeWidth=2;dashed=1;fontColor=#f3f4f6;fontSize=15;fontFamily=Helvetica;labelBackgroundColor=#111827;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="14" target="15" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=open;startArrow=none;strokeColor=#67e8f9;strokeWidth=2;dashed=1;fontColor=#f3f4f6;fontSize=15;fontFamily=Helvetica;labelBackgroundColor=#111827;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="15" target="16" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=open;startArrow=none;strokeColor=#67e8f9;strokeWidth=2;dashed=1;fontColor=#f3f4f6;fontSize=15;fontFamily=Helvetica;labelBackgroundColor=#111827;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="16" target="17" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="21" value="신청은 참여 확정이 아닙니다. 신청 단계에서는 참여자를 만들거나 현재 인원을 늘리지 않습니다. 거절/탈퇴 이력이 있어도 중복을 막습니다." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontColor=#cbd5e1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="60" y="745" width="1480" height="60" as="geometry" />
        </mxCell>
        <mxCell id="22" value="C. 모집자의 신청 수락 · MateApplicationService" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=24;fontColor=#f3f4f6;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="60" y="865" width="1480" height="40" as="geometry" />
        </mxCell>
        <mxCell id="23" value="1. 수락 조건 확인&#xa;모집자 본인 · 해당 신청&#xa;PENDING · 참여 이력 없음" style="rounded=0;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=19;fontColor=#f3f4f6;fillColor=#111827;strokeColor=#e5e7eb;strokeWidth=2;spacing=12;" parent="1" vertex="1">
          <mxGeometry x="60" y="940" width="310" height="135" as="geometry" />
        </mxCell>
        <mxCell id="24" value="2. 인원 증가&#xa;MatePost&#xa;OPEN/정원 확인 → +1" style="rounded=0;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=19;fontColor=#f3f4f6;fillColor=#153044;strokeColor=#67e8f9;strokeWidth=2;spacing=12;" parent="1" vertex="1">
          <mxGeometry x="450" y="940" width="310" height="135" as="geometry" />
        </mxCell>
        <mxCell id="25" value="3. 수락과 참여 생성&#xa;MateApplication: ACCEPTED&#xa;MateMember: ACTIVE" style="rounded=0;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=19;fontColor=#f3f4f6;fillColor=#111827;strokeColor=#e5e7eb;strokeWidth=2;spacing=12;" parent="1" vertex="1">
          <mxGeometry x="840" y="940" width="310" height="135" as="geometry" />
        </mxCell>
        <mxCell id="26" value="4. 활동 기록&#xa;event_activity_logs&#xa;+2 · 활성화 시" style="rounded=0;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=19;fontColor=#f3f4f6;fillColor=#111827;strokeColor=#e5e7eb;strokeWidth=2;spacing=12;" parent="1" vertex="1">
          <mxGeometry x="1230" y="940" width="310" height="135" as="geometry" />
        </mxCell>
        <mxCell id="27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=open;startArrow=none;strokeColor=#67e8f9;strokeWidth=2;dashed=1;fontColor=#f3f4f6;fontSize=15;fontFamily=Helvetica;labelBackgroundColor=#111827;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="23" target="24" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=open;startArrow=none;strokeColor=#67e8f9;strokeWidth=2;dashed=1;fontColor=#f3f4f6;fontSize=15;fontFamily=Helvetica;labelBackgroundColor=#111827;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="24" target="25" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=open;startArrow=none;strokeColor=#67e8f9;strokeWidth=2;dashed=1;fontColor=#f3f4f6;fontSize=15;fontFamily=Helvetica;labelBackgroundColor=#111827;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="25" target="26" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="30" value="같은 모집글의 수락은 순서대로 처리합니다. 2~4는 함께 저장되며 정원이 차면 CLOSED로 바뀝니다. 남은 대기 신청은 자동 거절되지 않습니다." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontColor=#cbd5e1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="60" y="1100" width="1480" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
