        <mxCell id="21" value="후기 통계는 회원별로 없거나 하나입니다.&#xa;통계 행이 없으면 원본 후기에서 계산합니다." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontColor=#cbd5e1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="70" y="195" width="490" height="80" as="geometry" />
        </mxCell>
        <mxCell id="22" value="후기: 같은 모집의 활성 참여자끼리만 작성 · 자기 평가 불가 · 작성자/대상자/모집 조합당 한 번 · 별점 1~5&#xa;경기 종료 여부 검증은 미구현입니다. 후기와 통계의 갱신 협력은 05 페이지에서 확인할 수 있습니다." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontColor=#cbd5e1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
