        </mxCell>
        <mxCell id="15" value="actor_id · 선택" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=none;startArrow=none;strokeColor=#94a3b8;strokeWidth=2;dashed=0;fontColor=#f3f4f6;fontSize=15;fontFamily=Helvetica;labelBackgroundColor=#111827;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="7" target="6" edge="1">
